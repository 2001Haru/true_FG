{
  "protocol": "hard_label_v1",
  "scope": "hard-label downstream evaluation",
  "student": {
    "architecture": "torchvision ResNet18",
    "backbone_initialization": "ResNet18_Weights.IMAGENET1K_V1",
    "classification_head_initialization": "torch.nn.Linear default random initialization",
    "backbone_trainable_from_update": 1
  },
  "optimization": {
    "optimizer": "SGD",
    "backbone_initial_lr": 0.0003,
    "head_initial_lr": 0.003,
    "backbone_min_lr": 0.0,
    "head_min_lr": 0.0,
    "momentum": 0.9,
    "dampening": 0.0,
    "nesterov": false,
    "weight_decay": 0.0005,
    "weight_decay_excludes": "all biases and all one-dimensional parameters, including BN affine parameters",
    "scheduler": "per-update full cosine",
    "scheduler_formula": "eta_min + (eta_0-eta_min)/2 * (1+cos(pi*t/U))",
    "scheduler_step_semantics": "update k uses t=k-1; scheduler state reaches t=U after update U",
    "warmup_updates": 0,
    "total_optimizer_updates": 3000
  },
  "batching": {
    "physical_batch_size": 64,
    "gradient_accumulation_steps": 1,
    "drop_last": false,
    "bn_running_statistics": "updated in train mode"
  },
  "supervision": {
    "loss": "cross entropy",
    "label_smoothing": 0.0,
    "cutmix": false,
    "mixup": false
  },
  "input": {
    "image_size": 224,
    "normalization_mean": [0.485, 0.456, 0.406],
    "normalization_std": [0.229, 0.224, 0.225],
    "train_transform": "Resize shorter edge to 256 (bilinear) -> RandomCrop 224 -> RandomHorizontalFlip(p=0.5)",
    "test_transform": "Resize shorter edge to 256 (bilinear) -> CenterCrop 224"
  },
  "loading": {
    "workers": 8,
    "persistent_workers": true,
    "pin_memory": true,
    "prefetch_factor": 2,
    "shuffle": true
  },
  "evaluation": {
    "validation_batch_size": 256,
    "evaluation_every_updates": 300,
    "evaluation_points": 10,
    "primary_metric": "final Top-1 at update 3000",
    "best_top1": "diagnostic only; not the primary reported result"
  },
  "seeding": {
    "student_seeds": [42, 43, 44],
    "student_seed_controls": [
      "random classification head",
      "training shuffle",
      "data augmentation",
      "PyTorch and CUDA runtime randomness"
    ]
  }
}
